# Firebase Backend Configuration (Primary)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Google OAuth 2.0 Web Client ID (from Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Resend Transactional Email API (https://resend.com)
EXPO_PUBLIC_RESEND_API_KEY=your_resend_api_key_here
EXPO_PUBLIC_RESEND_FROM_EMAIL="Oasis HRMS <notifications@subedge.com>"

# Gemini AI API
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here